/* ================= game ================= */
const KEY='festivalTrivia.v1', PTS={1:10,2:20,3:30};
const DNAME={1:'Easy',2:'Medium',3:'Hard'};
const CNAME={B:'Bible',H:'Holy Family in Egypt',C:'Coptic Church',I:'Brain teaser'};
let S={players:{},used:[]}, turn=null;
const DNAME_AR={1:'\u0633\u0647\u0644',2:'\u0645\u062a\u0648\u0633\u0637',3:'\u0635\u0639\u0628'};
const CNAME_AR={B:'الكتاب المقدس',H:'العائلة المقدسة في مصر',C:'الكنيسة القبطية',I:'سؤال ذكاء'};
const BOOKS={'1 Samuel':'صموئيل الأول','2 Samuel':'صموئيل الثاني','1 Kings':'الملوك الأول','2 Kings':'الملوك الثاني',
'Genesis':'تكوين','Exodus':'خروج','Numbers':'عدد','Deuteronomy':'تثنية','Joshua':'يشوع','Judges':'قضاة','Ruth':'راعوث',
'Ezra':'عزرا','Nehemiah':'نحميا','Esther':'أستير','Psalm':'مزمور','Isaiah':'إشعياء','Jeremiah':'إرميا','Ezekiel':'حزقيال',
'Daniel':'دانيال','Hosea':'هوشع','Jonah':'يونان','Micah':'ميخا','Matthew':'متى','Mark':'مرقس','Luke':'لوقا','John':'يوحنا',
'Acts':'أعمال الرسل','Galatians':'غلاطية','Philippians':'فيلبي','Colossians':'كولوسي','Philemon':'فليمون','Hebrews':'عبرانيين','Revelation':'رؤيا'};
const BOOKRE=new RegExp('('+Object.keys(BOOKS).join('|')+')(?= \\d)','g');
const WORDS=[['Coptic liturgical tradition','التقليد الطقسي القبطي'],['Coptic Synaxarium','السنكسار القبطي'],['Synaxarium','السنكسار'],
['Liturgy of St. Basil','القداس الباسيلي'],['Kiahk praises','تسابيح كيهك'],['Paschal greeting','تحية القيامة'],
['Baramouda','برمودة'],['Tobi','طوبة'],['Wikipedia','ويكيبيديا']];
function arRef(r){r=r.replace(BOOKRE,m=>BOOKS[m]);WORDS.forEach(w=>{r=r.split(w[0]).join(w[1]);});return r.replace(/;/g,'\u061B');}
const $=id=>document.getElementById(id);
const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;};

function load(){try{const r=localStorage.getItem(KEY);if(r){const o=JSON.parse(r);if(o&&o.players&&Array.isArray(o.used))S=o;}}catch(e){}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

/* Choose a question of difficulty d. Prefers ones nobody has had yet, and never one this player has seen if avoidable. */
function pick(d,wantIQ,p,taken){
  const all=[];Q.forEach((q,i)=>{if(q[0]===d&&!taken.includes(i))all.push(i);});
  const iq=i=>Q[i][1]==='I', fresh=i=>!S.used.includes(i)&&!p.seen.includes(i);
  let c=all.filter(i=>iq(i)===wantIQ&&fresh(i));
  if(!c.length)c=all.filter(fresh);
  if(!c.length){S.used=S.used.filter(i=>Q[i][0]!==d);c=all.filter(i=>iq(i)===wantIQ&&!p.seen.includes(i));}
  if(!c.length)c=all.filter(i=>!p.seen.includes(i));
  if(!c.length){p.seen=p.seen.filter(i=>Q[i][0]!==d);c=all;}
  return c[Math.floor(Math.random()*c.length)];
}

function renderBoard(bumpKey){
  const list=$('list');list.textContent='';
  const arr=Object.entries(S.players).sort((a,b)=>b[1].score-a[1].score||a[1].name.localeCompare(b[1].name));
  if(!arr.length)list.appendChild(el('li','empty','No players yet. Type a name and press GO.'));
  arr.forEach(([k,p],i)=>{
    const li=el('li','row'+(turn&&turn.key===k?' active':'')+(bumpKey===k?' bump':''));
    li.appendChild(el('span','rk',i+1));
    const nm=el('span','nm',p.name);nm.appendChild(el('small','',p.plays+(p.plays===1?' turn':' turns')));li.appendChild(nm);
    li.appendChild(el('span','pt',p.score));
    const del=el('button','del','\u00D7');del.setAttribute('aria-label','Remove '+p.name);
    del.onclick=ev=>{ev.stopPropagation();if(confirm('Remove '+p.name+' from the scoreboard?')){delete S.players[k];save();renderBoard();}};
    li.appendChild(del);
    li.onclick=()=>{const inp=$('nameInput');if(inp){inp.value=p.name;}};
    list.appendChild(li);
  });
  const act=list.querySelector('.active');if(act&&act.scrollIntoView)act.scrollIntoView({block:'nearest'});
  $('stat').textContent=arr.length+(arr.length===1?' player':' players')+' \u00B7 '+(Q.length-S.used.length)+' of '+Q.length+' questions not used yet';
}

function showStart(){
  turn=null;$('pill').textContent='';
  const v=$('view');v.textContent='';v.dir='ltr';
  const c=el('div','center');
  c.appendChild(el('div','kicker','Bible \u00B7 Holy Family in Egypt \u00B7 Coptic Church \u00B7 Brain teasers'));
  c.appendChild(el('div','big','Who is playing?'));
  c.appendChild(el('p','sub','Three questions per turn: easy (10), medium (20), hard (30).'));
  const inp=el('input','name');inp.id='nameInput';inp.type='text';inp.placeholder='Player name';inp.maxLength=24;
  inp.autocomplete='off';inp.setAttribute('autocapitalize','words');inp.setAttribute('autocorrect','off');inp.spellcheck=false;
  const go=el('button','go','GO'), yalla=el('button','go ar','\u064A\u0644\u0627 \u0628\u064A\u0646\u0627');
  yalla.lang='ar';yalla.dir='rtl';
  go.onclick=()=>startTurn(inp,'en');
  yalla.onclick=()=>startTurn(inp,'ar');
  inp.onkeydown=e=>{if(e.key==='Enter')startTurn(inp,'en');};
  const gos=el('div','gos');gos.appendChild(go);gos.appendChild(yalla);
  c.appendChild(inp);c.appendChild(gos);
  c.appendChild(el('div','hint','Playing again? Tap a name on the scoreboard to fill it in. Points add to the same player.'));
  v.appendChild(c);renderBoard();
}

function startTurn(inp,lang){
  const name=inp.value.replace(/\s+/g,' ').trim();
  if(!name){inp.classList.remove('shake');void inp.offsetWidth;inp.classList.add('shake');inp.focus();return;}
  inp.blur();
  const key=name.toLowerCase();
  if(!S.players[key])S.players[key]={name:name,score:0,plays:0,seen:[]};
  const p=S.players[key];p.plays++;
  const kinds=shuffle([false,true,Math.random()<0.45]);   /* at least one religious and one brain teaser */
  const qs=[];[1,2,3].forEach((d,n)=>qs.push(pick(d,kinds[n],p,qs)));
  turn={key:key,qs:qs,n:0,res:[],gained:0,lang:lang};
  save();showQuestion();
}

function showQuestion(){
  const p=S.players[turn.key], qi=turn.qs[turn.n], q=Q[qi], d=q[0], isIQ=q[1]==='I';
  if(!S.used.includes(qi))S.used.push(qi);
  if(!p.seen.includes(qi))p.seen.push(qi);
  save();
  const L=turn.lang==='ar', a=L?AR[qi]:null;
  const qText=L?a[0]:q[2], right0=L?a[1]:q[3], pool=L?a.slice(1,5):[q[3],q[4],q[5],q[6]];
  const refText=L?(a[5]||arRef(q[7])):q[7];
  $('pill').textContent=L?'السؤال '+(turn.n+1)+' من 3':'Question '+(turn.n+1)+' of 3';
  const v=$('view');v.textContent='';v.scrollTop=0;v.dir=L?'rtl':'ltr';
  const head=el('div','qhead');
  head.appendChild(el('span','who',p.name));
  head.appendChild(el('span','tag'+(isIQ?' iq':''),(L?CNAME_AR:CNAME)[q[1]]));
  head.appendChild(el('span','tag d'+d,L?DNAME_AR[d]+' \u00B7 '+PTS[d]+' نقطة':DNAME[d]+' \u00B7 '+PTS[d]+' pts'));
  v.appendChild(head);
  const steps=el('div','steps');
  for(let i=0;i<3;i++)steps.appendChild(el('i',i<turn.n?(turn.res[i]?'ok':'no'):(i===turn.n?'now':'')));
  v.appendChild(steps);
  v.appendChild(el('h2','qtext',qText));
  const opts=el('div','opts'), answers=shuffle(pool), after=el('div','after');
  answers.forEach((ans,i)=>{
    const b=el('button','opt');b.appendChild(el('b','',(L?'أبجد':'ABCD')[i]));b.appendChild(el('span','',ans));
    b.onclick=()=>{
      if(turn.locked)return;turn.locked=true;
      const right=ans===right0;
      [...opts.children].forEach((o,j)=>{o.classList.add('done');if(answers[j]===right0)o.classList.add('right');});
      if(!right)b.classList.add('wrong');
      turn.res.push(right);
      if(right){p.score+=PTS[d];turn.gained+=PTS[d];}
      save();renderBoard(right?turn.key:null);
      steps.children[turn.n].className=right?'ok':'no';
      after.appendChild(el('span','fb '+(right?'ok':'no'),L?(right?'إجابة صحيحة! كسبت '+PTS[d]+' نقطة':'ليست هذه. الإجابة: '+right0):(right?'Correct! +'+PTS[d]+' points':'Not this time. Answer: '+q[3])));
      const nx=el('button','next',L?(turn.n<2?'السؤال التالي':'إنهاء الدور'):(turn.n<2?'Next question':'Finish turn'));
      nx.onclick=()=>{turn.locked=false;turn.n++;if(turn.n<3)showQuestion();else showSummary();};
      after.appendChild(nx);
      after.appendChild(el('div','ref',(L?(isIQ?'السبب: ':'المرجع: '):(isIQ?'Why: ':'Reference: '))+refText));
      nx.scrollIntoView({block:'nearest'});
    };
    opts.appendChild(b);
  });
  v.appendChild(opts);v.appendChild(after);renderBoard();
}

function showSummary(){
  const p=S.players[turn.key], t=turn;
  $('pill').textContent='';
  const L=t.lang==='ar';
  const v=$('view');v.textContent='';v.dir=L?'rtl':'ltr';
  const c=el('div','center');
  c.appendChild(el('div','kicker',p.name));
  const sb=el('div','score-big','+'+t.gained);sb.dir='ltr';c.appendChild(sb);
  c.appendChild(el('p','sub',L?'نقطة في هذا الدور \u00B7 المجموع '+p.score:'points this turn \u00B7 total '+p.score));
  const dots=el('div','dots');t.res.forEach(r=>dots.appendChild(el('span',r?'ok':'no',r?'\u2713':'\u00D7')));c.appendChild(dots);
  const b=el('button','go'+(L?' ar':''),L?'اللاعب التالي':'NEXT PLAYER');b.style.fontSize='22px';b.onclick=showStart;c.appendChild(b);
  v.appendChild(c);
  turn=null;renderBoard(t.key);
}

$('bSrc').onclick=()=>$('ov').classList.add('on');
$('bClose').onclick=()=>$('ov').classList.remove('on');
$('ov').onclick=e=>{if(e.target===$('ov'))$('ov').classList.remove('on');};
$('bEdit').onclick=()=>{const on=$('board').classList.toggle('edit');$('bEdit').textContent=on?'Done':'Edit';};
$('bReset').onclick=()=>{
  if(!confirm('Start a new game? This erases ALL names and scores.'))return;
  if(!confirm('Are you sure? This cannot be undone.'))return;
  S={players:{},used:[]};save();showStart();
};

load();showStart();
</script>
