<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Festival Trivia</title>
<style>
:root{
  --paper:#f5ecd7; --paper2:#ecdfc1; --ink:#2b1a14; --muted:#7a6552;
  --wine:#6e1423; --wine2:#4d0d18; --gold:#c9982f; --gold2:#e9c873;
  --teal:#1d5c59; --ok:#2e7d4f; --bad:#b3261e; --line:#d8c7a2;
  --serif:"Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{font-family:var(--sans);color:var(--ink);background:var(--paper);touch-action:manipulation;overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
.app{display:grid;grid-template-columns:minmax(0,1fr) clamp(250px,31vw,380px);height:100vh;height:100dvh}

/* ---------- stage (left) ---------- */
.stage{display:flex;flex-direction:column;min-width:0;height:100%;overflow:hidden;
  background:radial-gradient(1200px 500px at 20% -10%,#fff8e6 0,transparent 60%),var(--paper)}
.top{display:flex;align-items:center;gap:12px;padding:14px 22px;border-bottom:1px solid var(--line)}
.top svg{width:30px;height:30px;flex:none}
.top h1{font-family:var(--serif);font-size:22px;margin:0;letter-spacing:.3px;color:var(--wine)}
.top .sp{flex:1}
.pill{font-size:13px;color:var(--muted)}
.view{flex:1;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch;padding:22px;display:flex;flex-direction:column}
.center{margin:auto;width:100%;max-width:640px;text-align:center}

/* start */
.kicker{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:700}
.big{font-family:var(--serif);font-size:clamp(34px,5vw,54px);line-height:1.05;margin:10px 0 8px;color:var(--wine)}
.sub{color:var(--muted);font-size:17px;margin:0 0 26px}
.name{width:100%;font:600 24px var(--sans);padding:16px 18px;border:2px solid var(--line);border-radius:14px;
  background:#fffdf6;color:var(--ink);text-align:center;outline:none;-webkit-appearance:none}
.name:focus{border-color:var(--gold)}
.go{margin-top:16px;width:100%;border:0;border-radius:14px;padding:18px;font:800 28px var(--serif);letter-spacing:.12em;
  color:#fff7e0;background:linear-gradient(180deg,var(--wine),var(--wine2));box-shadow:0 6px 0 #32070f,0 14px 24px rgba(77,13,24,.25)}
.go:active{transform:translateY(4px);box-shadow:0 2px 0 #32070f}
.gos{display:flex;gap:12px}.gos .go{flex:1}
.go.ar{font-family:var(--sans);letter-spacing:0}
[dir=rtl] .qtext,[dir=rtl] .who{font-family:var(--sans);line-height:1.5}
[dir=rtl] .kicker,[dir=rtl] .tag{letter-spacing:0}
.hint{margin-top:18px;font-size:14px;color:var(--muted)}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* question */
.qhead{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px}
.who{font-family:var(--serif);font-size:26px;font-weight:700;color:var(--wine);margin-inline-end:auto}
.tag{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;border:1px solid var(--line);background:#fffaf0;white-space:nowrap}
.tag.d1{color:var(--ok);border-color:#b9d8c4}.tag.d2{color:#a8690a;border-color:#ecd29a}.tag.d3{color:var(--bad);border-color:#e9b8b3}
.tag.iq{color:var(--teal);border-color:#a9cfcc}
.steps{display:flex;gap:8px;margin-bottom:18px}
.steps i{flex:1;height:8px;border-radius:8px;background:var(--paper2)}
.steps i.now{background:var(--gold)}.steps i.ok{background:var(--ok)}.steps i.no{background:var(--bad)}
.qtext{font-family:var(--serif);font-size:clamp(24px,3.1vw,34px);line-height:1.25;margin:0 0 20px}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.opt{display:flex;align-items:center;gap:12px;text-align:start;min-height:76px;padding:14px 16px;border-radius:14px;
  border:2px solid var(--line);background:#fffdf6;font-size:clamp(17px,1.9vw,21px);font-weight:600;line-height:1.25}
.opt b{flex:none;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--paper2);color:var(--wine);font-size:16px}
.opt:active{border-color:var(--gold)}
.opt.done{pointer-events:none;opacity:.5}
.opt.right{opacity:1;border-color:var(--ok);background:#e5f3ea}.opt.right b{background:var(--ok);color:#fff}
.opt.wrong{opacity:1;border-color:var(--bad);background:#fbe7e5}.opt.wrong b{background:var(--bad);color:#fff}
.after{margin-top:16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.fb{font-size:20px;font-weight:800}.fb.ok{color:var(--ok)}.fb.no{color:var(--bad)}
.ref{flex-basis:100%;font-size:15px;color:var(--muted);margin-top:-6px}
.next{margin-inline-start:auto;border:0;border-radius:12px;padding:14px 26px;font-weight:800;font-size:18px;color:#fff7e0;background:var(--wine)}
.next:active{background:var(--wine2)}

/* summary */
.score-big{font-family:var(--serif);font-size:84px;line-height:1;color:var(--wine);margin:8px 0}
.dots{display:flex;justify-content:center;gap:10px;margin:14px 0 24px}
.dots span{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:20px}
.dots .ok{background:var(--ok)}.dots .no{background:var(--bad)}

/* ---------- board (right) ---------- */
.board{display:flex;flex-direction:column;height:100%;min-height:0;color:#fbf1d8;
  background:linear-gradient(180deg,var(--wine) 0,var(--wine2) 100%);border-left:4px solid var(--gold)}
.board h2{font-family:var(--serif);font-size:22px;margin:0;padding:16px 18px 12px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold2);
  border-bottom:1px solid rgba(233,200,115,.3)}
.list{flex:1;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch;margin:0;padding:8px 10px;list-style:none}
.row{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;font-size:18px}
.row .rk{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:14px;font-weight:800;background:rgba(255,255,255,.1)}
.row:nth-child(1) .rk{background:var(--gold2);color:var(--wine2)}
.row:nth-child(2) .rk{background:#d9d9d9;color:var(--wine2)}
.row:nth-child(3) .rk{background:#c98b5a;color:var(--wine2)}
.row .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}
.row .nm small{display:block;font-weight:400;font-size:12px;opacity:.65}
.row .pt{font-family:var(--serif);font-size:22px;font-weight:700;color:var(--gold2);font-variant-numeric:tabular-nums}
.row.active{background:rgba(233,200,115,.18);outline:1px solid rgba(233,200,115,.5)}
.row.bump .pt{animation:bump .6s}
@keyframes bump{30%{transform:scale(1.5);color:#fff}}
.row .del{display:none;border:0;border-radius:8px;background:#fff;color:var(--bad);font-weight:800;width:32px;height:32px}
.board.edit .row .del{display:block}
.empty{padding:24px 14px;opacity:.7;text-align:center;font-size:15px}
.foot{padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid rgba(233,200,115,.3)}
.stat{font-size:12px;opacity:.75;margin-bottom:8px;text-align:center}
.btns{display:flex;gap:6px}
.btns button{flex:1;border:1px solid rgba(233,200,115,.45);background:transparent;color:#fbf1d8;border-radius:9px;padding:9px 4px;font-size:13px;font-weight:600}
.btns button:active{background:rgba(255,255,255,.12)}

/* sources overlay */
.ov{position:fixed;inset:0;background:rgba(43,26,20,.6);display:none;align-items:center;justify-content:center;padding:20px;z-index:10}
.ov.on{display:flex}
.sheet{background:var(--paper);border-radius:16px;max-width:720px;width:100%;max-height:86vh;overflow:auto;-webkit-overflow-scrolling:touch;padding:24px 26px}
.sheet h3{font-family:var(--serif);color:var(--wine);margin:0 0 10px;font-size:26px}
.sheet h4{margin:18px 0 6px;color:var(--wine)}
.sheet li{margin:4px 0;line-height:1.4}
.sheet .next{display:block;margin:18px 0 0 auto}

@media (max-width:820px){.opts{grid-template-columns:1fr}.opt{min-height:60px}}
@media (max-width:560px){body{overflow:auto}.app{grid-template-columns:1fr;height:auto}.board{height:60vh;border-left:0;border-top:4px solid var(--gold)}}
</style>
</head>
<body>
<div class="app">
  <section class="stage">
    <header class="top">
      <svg viewBox="0 0 40 40" aria-hidden="true"><g fill="none" stroke="#c9982f" stroke-width="3.2" stroke-linecap="round"><path d="M20 6v28M6 20h28"/></g><g fill="#6e1423"><circle cx="20" cy="5" r="3.2"/><circle cx="20" cy="35" r="3.2"/><circle cx="5" cy="20" r="3.2"/><circle cx="35" cy="20" r="3.2"/><circle cx="20" cy="20" r="4.2"/></g></svg>
      <h1>Festival Trivia</h1><span class="sp"></span><span class="pill" id="pill"></span>
    </header>
    <div class="view" id="view"></div>
  </section>

  <aside class="board" id="board">
    <h2>Scoreboard</h2>
    <ol class="list" id="list"></ol>
    <div class="foot">
      <div class="stat" id="stat"></div>
      <div class="btns">
        <button id="bSrc">Sources</button>
        <button id="bEdit">Edit</button>
        <button id="bReset">Reset</button>
      </div>
    </div>
  </aside>
</div>

<div class="ov" id="ov"><div class="sheet">
  <h3>Question sources</h3>
  <p>Every question shows its own reference after it is answered.</p>
  <h4>Bible</h4>
  <ul><li>The Holy Bible. Each question lists its book, chapter and verse (verse numbering as in the NKJV).</li></ul>
  <h4>The Holy Family in Egypt</h4>
  <ul>
    <li>Gospel of St. Matthew 2:13-23; Hosea 11:1; Isaiah 19</li>
    <li>Coptic Orthodox Church (official site): "Holy Family" (copticorthodox.church)</li>
    <li>Egypt State Information Service: "The Holy Family in its Journey to Egypt" (sis.gov.eg)</li>
    <li>St. Mark Coptic Orthodox Church, London: "Lord Jesus' entry into Egypt" (stmark.org.uk)</li>
    <li>St. Mary &amp; St. John Coptic Church: "Feast of Entry of the Lord into Egypt" (smsanj.org)</li>
    <li>Watani: "Entry of Holy Family into Egypt: a national feast?" (wataninet.com)</li>
    <li>Memphis Tours "Trail of the Holy Family"; Pilgrimaps "The Holy Family Route today"</li>
  </ul>
  <h4>Coptic Church</h4>
  <ul>
    <li>Coptic Orthodox Diocese of the Southern US: "On Fasting" (suscopts.org)</li>
    <li>Coptic Orthodox Diocese of Los Angeles: "The Feasts of the Church" (lacopts.org)</li>
    <li>St. Mary Coptic Church: "Apostles Fast" fasting timeline (saint-mary.net)</li>
    <li>St. Demiana Coptic Church: "Fasts &amp; Feasts" (stdemianasa.org)</li>
    <li>The Coptic Synaxarium (lives of the saints)</li>
    <li>Wikipedia articles named in the individual references (Pope of the Coptic Orthodox Church, Coptic calendar, Agpeya, and others)</li>
  </ul>
  <h4>Brain teasers</h4>
  <ul><li>Classic number-pattern, logic and riddle types written for this game. Each one shows a short explanation of its answer.</li></ul>
  <button class="next" id="bClose">Close</button>
</div></div>

<script>
/* Question format: [difficulty 1-3, category, question, CORRECT answer, wrong, wrong, wrong, reference]
   Categories: B = Bible, H = Holy Family in Egypt, C = Coptic Church, I = brain teaser
   The first answer is always the correct one; the game shuffles the order on screen.
   IMPORTANT: add new questions at the END of the list so saved games stay in sync. */
const HF='copticorthodox.church, "Holy Family"';
const SIS='Egypt State Information Service, "The Holy Family in its Journey to Egypt"';
const MT='Memphis Tours, "Trail of the Holy Family in Egypt"';
const ENT='smsanj.org, "Feast of Entry of the Lord into Egypt"';
const FST='suscopts.org "On Fasting"; saint-mary.net fasting timeline';
const FEA='lacopts.org, "The Feasts of the Church"';
const POPE='Wikipedia, "Pope of the Coptic Orthodox Church"';
const CAL='Wikipedia, "Coptic calendar"';
const LIT='Coptic liturgical tradition';
/*QSTART*/
const Q=[
/* ===== EASY: Bible ===== */
[1,'B',"Who built the ark to survive the great flood?","Noah","Moses","Abraham","David","Genesis 6:13-14"],
[1,'B',"Who was the first man God created?","Adam","Noah","Abel","Seth","Genesis 2:7, 2:20"],
[1,'B',"Who was the first woman?","Eve","Sarah","Mary","Ruth","Genesis 3:20"],
[1,'B',"On which day did God rest after creation?","The seventh day","The first day","The third day","The sixth day","Genesis 2:2"],
[1,'B',"Which prophet was swallowed by a great fish?","Jonah","Elijah","Daniel","Isaiah","Jonah 1:17"],
[1,'B',"Who defeated the giant Goliath?","David","Saul","Samson","Joshua","1 Samuel 17:49-50"],
[1,'B',"In which town was Jesus born?","Bethlehem","Nazareth","Jerusalem","Capernaum","Matthew 2:1"],
[1,'B',"How many apostles did Jesus choose?","12","7","10","40","Matthew 10:1-4"],
[1,'B',"Which apostle betrayed Jesus?","Judas Iscariot","Peter","Thomas","Andrew","Matthew 26:14-16"],
[1,'B',"Who was thrown into the lions' den?","Daniel","Joseph","Jeremiah","Jonah","Daniel 6:16"],
[1,'B',"What is the first book of the Bible?","Genesis","Exodus","Matthew","Psalms","Genesis 1:1"],
[1,'B',"What is the last book of the Bible?","Revelation","Jude","Acts","Malachi","Revelation 22:21"],
[1,'B',"Who led the Israelites out of Egypt?","Moses","Joshua","Abraham","Solomon","Exodus 3:10; 12:51"],
[1,'B',"How many commandments did God write on the tablets for Moses?","Ten","Seven","Twelve","Five","Exodus 34:28"],
[1,'B',"Which sea did God part for the Israelites?","The Red Sea","The Dead Sea","The Sea of Galilee","The Mediterranean Sea","Exodus 14:21-22; 15:4"],
[1,'B',"Who baptized Jesus?","John the Baptist","Peter","Paul","Andrew","Matthew 3:13-15"],
[1,'B',"In which river was Jesus baptized?","The Jordan","The Nile","The Euphrates","The Tigris","Mark 1:9"],
[1,'B',"At the wedding in Cana, Jesus turned water into what?","Wine","Milk","Oil","Honey","John 2:1-11"],
[1,'B',"Which son of Jacob received a tunic of many colors?","Joseph","Benjamin","Reuben","Judah","Genesis 37:3"],
[1,'B',"For how many days and nights did it rain during the flood?","40","7","12","100","Genesis 7:12"],
[1,'B',"What sign did God give Noah as a promise never to flood the whole earth again?","A rainbow","A dove","A star","A burning bush","Genesis 9:13"],
[1,'B',"Which apostle denied Jesus three times?","Peter","John","James","Philip","Luke 22:61"],
[1,'B',"Which angel announced to the Virgin Mary that she would bear Jesus?","Gabriel","Michael","Raphael","Suriel","Luke 1:26-31"],
[1,'B',"Jesus fed the five thousand with five loaves and how many fish?","Two","Five","Seven","Twelve","John 6:9-11"],
[1,'B',"Who climbed a sycamore tree to see Jesus?","Zacchaeus","Bartimaeus","Nicodemus","Lazarus","Luke 19:2-4"],
[1,'B',"In which garden did Adam and Eve live?","Eden","Gethsemane","Babylon","Carmel","Genesis 2:8"],
[1,'B',"What gifts did the wise men bring to Jesus?","Gold, frankincense and myrrh","Gold, silver and bronze","Bread, wine and oil","Silk, spices and pearls","Matthew 2:11"],
[1,'B',"Which judge had great strength connected to his uncut hair?","Samson","Gideon","Samuel","Eli","Judges 16:17"],
[1,'B',"How many Gospels are in the New Testament?","Four","Three","Five","Twelve","Matthew, Mark, Luke and John"],
[1,'B',"What creature tempted Eve in the garden?","A serpent","A lion","A raven","A wolf","Genesis 3:1"],
[1,'B',"Who killed his brother Abel?","Cain","Seth","Esau","Ham","Genesis 4:8"],
[1,'B',"Complete the verse: \"The Lord is my shepherd; I shall not ...\"","Want","Fear","Fall","Sleep","Psalm 23:1 (Psalm 22 in the Agpeya numbering)"],
[1,'B',"On what animal did Jesus enter Jerusalem?","A donkey","A horse","A camel","A chariot","Matthew 21:5-7"],
[1,'B',"What tower did people build to try to reach the heavens?","Babel","Siloam","Jericho","Zion","Genesis 11:4-9"],
[1,'B',"What guided the wise men to the Child Jesus?","A star","A cloud","A dove","A pillar of fire","Matthew 2:2, 2:9"],
[1,'B',"Which baby was placed in a basket among the reeds of the river?","Moses","Samuel","Isaac","Joseph","Exodus 2:3-10"],
[1,'B',"Whom did Jesus raise after four days in the tomb?","Lazarus","Jairus","Stephen","Zacchaeus","John 11:39-44"],
[1,'B',"Who was the brother of Moses and the first high priest?","Aaron","Joshua","Caleb","Hur","Exodus 4:14; 28:1"],
[1,'B',"For how many years did Israel wander in the wilderness?","40","7","12","70","Numbers 14:33"],
[1,'B',"What was the trade of Joseph, the guardian of Jesus?","Carpenter","Fisherman","Shepherd","Tax collector","Matthew 13:55"],
[1,'B',"Who was the twin brother of Jacob?","Esau","Laban","Lot","Ishmael","Genesis 25:25-26"],
[1,'B',"What food did God send from heaven to feed Israel in the wilderness?","Manna","Figs","Barley bread","Honeycomb","Exodus 16:31"],
/* ===== EASY: Holy Family ===== */
[1,'H',"To which country did the Holy Family flee?","Egypt","Syria","Greece","Persia","Matthew 2:13-14"],
[1,'H',"Who told Joseph in a dream to take the Child and His mother and flee?","An angel of the Lord","The wise men","A shepherd","Simeon the elder","Matthew 2:13"],
[1,'H',"Which king wanted to destroy the Child Jesus?","Herod","Pharaoh","Caesar Augustus","Nebuchadnezzar","Matthew 2:13, 2:16"],
[1,'H',"Which Gospel tells the story of the flight into Egypt?","Matthew","Mark","Luke","John","Matthew 2:13-23"],
[1,'H',"On which river did the Holy Family sail south in Egypt?","The Nile","The Jordan","The Euphrates","The Tigris",HF],
[1,'H',"When did the Holy Family return from Egypt?","After Herod died","After the Passover","When Jesus turned twelve","When the wise men came back","Matthew 2:19-21"],
[1,'H',"After returning from Egypt, in which town did the Holy Family live?","Nazareth","Bethlehem","Jericho","Bethany","Matthew 2:23"],
[1,'H',"Who were the members of the Holy Family?","Jesus, Mary and Joseph","Jesus, Mary and John","Jesus, Peter and Mary","Mary, Elizabeth and Zechariah","Matthew 2:14"],
/* ===== EASY: Coptic Church ===== */
[1,'C',"Which apostle and evangelist founded the Church of Alexandria?","St. Mark","St. Peter","St. Paul","St. Thomas",'Wikipedia, "Coptic Orthodox Church"; Synaxarium, 30 Baramouda'],
[1,'C',"The Coptic Pope is the Pope of which city?","Alexandria","Rome","Antioch","Constantinople",POPE],
[1,'C',"On what date does the Coptic Church celebrate the Nativity (Christmas)?","January 7","December 25","January 19","January 1",FEA],
[1,'C',"Who is the current Pope of the Coptic Orthodox Church?","Pope Tawadros II","Pope Shenouda III","Pope Kyrillos VI","Pope Theophilus",POPE],
[1,'C',"What does \"Kyrie eleison\" mean?","Lord have mercy","Christ is risen","Holy God","Peace be with you",LIT+' (Liturgy of St. Basil)'],
[1,'C',"Which Egyptian saint is called the \"Father of Monks\"?","St. Anthony the Great","St. Mina","St. George","St. Mark",'Synaxarium, 22 Tobi; Wikipedia, "Anthony the Great"'],
[1,'C',"Which animal is the symbol of St. Mark?","Lion","Eagle","Ox","Lamb",'Wikipedia, "Mark the Evangelist"'],
[1,'C',"The word \"Copt\" originally means what?","Egyptian","Greek","Monk","Pilgrim",'Wikipedia, "Copts" (from Greek Aigyptos)'],
[1,'C',"What is the Coptic book of daily prayers of the hours called?","Agpeya","Synaxarium","Katameros","Psalmody",'Wikipedia, "Agpeya"'],
[1,'C',"On which two days of the week do Copts fast for most of the year?","Wednesday and Friday","Monday and Thursday","Saturday and Sunday","Tuesday and Friday",FST],
[1,'C',"How many sacraments does the Coptic Orthodox Church have?","Seven","Two","Three","Twelve",'Wikipedia, "Coptic Orthodox Church"'],
[1,'C',"Who was the Coptic Pope immediately before Pope Tawadros II?","Pope Shenouda III","Pope Kyrillos VI","Pope Yousab II","Pope Athanasius",POPE],
[1,'C',"What is the feast of the Coptic New Year called?","Nayrouz","Epiphany","Pentecost","Kiahk",'stdemianasa.org, "Fasts & Feasts"'],
[1,'C',"What is the holy bread offered in the Divine Liturgy called?","Qurban (Korban)","Manna","Agpeya","Myron",LIT],
/* ===== EASY: brain teasers ===== */
[1,'I',"What comes next: 2, 4, 6, 8, ?","10","9","12","16","Add 2 each time."],
[1,'I',"Which is the odd one out?","Carrot","Apple","Banana","Mango","The others are fruits."],
[1,'I',"How many months of the year have 28 days?","All 12","1","2","6","Every month has at least 28 days."],
[1,'I',"What comes next: 5, 10, 15, 20, ?","25","22","30","24","Add 5 each time."],
[1,'I',"Which weighs more: a kilogram of iron or a kilogram of feathers?","They weigh the same","The iron","The feathers","It depends on the weather","Both are exactly one kilogram."],
[1,'I',"There are 3 apples and you take away 2. How many do you have?","2","1","3","5","You took 2, so you have 2."],
[1,'I',"What is the opposite of \"ancient\"?","Modern","Old","Huge","Rare","Ancient means very old."],
[1,'I',"Hand is to glove as foot is to ...","Sock","Leg","Toe","Hat","A glove covers a hand; a sock covers a foot."],
[1,'I',"How many sides does a hexagon have?","6","5","7","8","Hexa means six."],
[1,'I',"How many days are in a leap year?","366","365","364","360","February gets one extra day."],
[1,'I',"What comes next: 1, 3, 5, 7, ?","9","8","10","11","Odd numbers."],
[1,'I',"What is half of 50, plus 10?","35","30","60","25","25 + 10 = 35."],
[1,'I',"Which shape has no corners?","Circle","Square","Triangle","Rectangle","A circle is one smooth curve."],
[1,'I',"What comes next: A, C, E, G, ?","I","H","J","K","Skip one letter each time."],
[1,'I',"Bird is to fly as fish is to ...","Swim","Water","Scale","Net","It is how each one moves."],
[1,'I',"What comes next: Monday, Wednesday, Friday, ?","Sunday","Saturday","Tuesday","Thursday","Skip one day each time."],
[1,'I',"Which number is the largest?","0.75","0.5","0.25","0.125","0.75 is three quarters."],
